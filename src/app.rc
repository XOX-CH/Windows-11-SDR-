#pragma code_page(65001)

#include <windows.h>
#include "resource.h"

IDI_APP ICON "res\\App.ico"
IDI_TRAY_ON_DARK ICON "res\\tray-on-dark.ico"
IDI_TRAY_ON_LIGHT ICON "res\\tray-on-light.ico"

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,5,0,0
 PRODUCTVERSION 2,5,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "SDR 亮度"
            VALUE "FileVersion", "2.5.0.0"
            VALUE "InternalName", "SdrTray"
            VALUE "OriginalFilename", "SdrTray.exe"
            VALUE "ProductName", "SDR 亮度"
            VALUE "ProductVersion", "2.5.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
